# opusfile installed pkg-config file

prefix=/home/g7/mer/android/droid/hybris/mw/harbour-classicciv/harbour-classicciv-0.1.0/_deps/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: opusfile
Description: High-level Opus decoding library
Version: 0.12
Requires.private: ogg >= 1.3 opus >= 1.0.1
Conflicts:
Libs: -L${libdir} -lopusfile
Libs.private: -lm
Cflags: -I${includedir}/opus
